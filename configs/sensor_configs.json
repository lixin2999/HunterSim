{
  "version": "2.0",
  "description": "HUNTER SE 传感器配置模板（V3.0.0 型号剖面；与 src/hunter_sim/sensor_sim/profiles.py 双向对应）",
  "default_profile": "hunter_se_full",
  "profiles": {
    "helios_16p": {
      "profile_name": "helios_16p",
      "description": "RS-Helios-16P 16 线机械式 LiDAR",
      "lidar": {
        "channels": 16,
        "range_m": 150.0,
        "points_per_second": 131072,
        "rotation_frequency_hz": 10.0,
        "upper_fov_deg": 15.0,
        "lower_fov_deg": -15.0,
        "horizontal_fov_deg": 360.0,
        "noise_stddev_m": 0.02,
        "dropoff_rate": 0.0
      }
    },
    "d435": {
      "profile_name": "d435",
      "description": "Intel RealSense D435 RGB-D",
      "rgb_camera": {
        "width": 1280,
        "height": 720,
        "fov_deg": 69.0,
        "fps": 30.0,
        "noise_intensity": 0.0,
        "motion_blur": false
      },
      "depth_camera": {
        "width": 1280,
        "height": 720,
        "fov_deg": 87.0,
        "fps": 30.0,
        "min_depth_m": 0.2,
        "max_depth_m": 10.0
      }
    },
    "ch10x": {
      "profile_name": "ch10x",
      "description": "CH10X 惯导单元 IMU",
      "imu": {
        "frequency_hz": 100.0,
        "accel_noise_stddev": 0.01,
        "gyro_noise_stddev": 0.001,
        "accel_bias_drift": 0.0,
        "gyro_bias_drift": 0.0
      }
    },
    "hunter_se_full": {
      "profile_name": "hunter_se_full",
      "description": "HUNTER SE 三件套全挂（LiDAR + RGB-D + IMU）",
      "components": ["helios_16p", "d435", "ch10x"]
    }
  },
  "mounts": {
    "lidar": {
      "x": 0.23,
      "y": 0.0,
      "z": 0.35,
      "pitch": 0.0,
      "yaw": 0.0,
      "roll": 0.0
    },
    "rgb_camera": {
      "x": 0.4,
      "y": 0.0,
      "z": 0.3,
      "pitch": 0.0,
      "yaw": 0.0,
      "roll": 0.0
    },
    "depth_camera": {
      "x": 0.4,
      "y": 0.0,
      "z": 0.3,
      "pitch": 0.0,
      "yaw": 0.0,
      "roll": 0.0
    },
    "imu": {
      "x": 0.23,
      "y": 0.0,
      "z": 0.15,
      "pitch": 0.0,
      "yaw": 0.0,
      "roll": 0.0
    },
    "gnss": {
      "x": 0.0,
      "y": 0.0,
      "z": 0.33,
      "pitch": 0.0,
      "yaw": 0.0,
      "roll": 0.0
    }
  },
  "topics": {
    "lidar": {
      "blueprint": "sensor.lidar.ray_cast",
      "ros_topic": "/carla/lidar_points",
      "real_topic": "/lidar_points",
      "msg_type": "sensor_msgs/PointCloud2"
    },
    "rgb_camera": {
      "blueprint": "sensor.camera.rgb",
      "ros_topic": "/carla/camera/color/image_raw",
      "real_topic": "/camera/color/image_raw",
      "msg_type": "sensor_msgs/Image",
      "corresponding_real_sensor": "Intel RealSense D435 RGB"
    },
    "depth_camera": {
      "blueprint": "sensor.camera.depth",
      "ros_topic": "/carla/camera/depth/image_rect_raw",
      "real_topic": "/camera/depth/image_rect_raw",
      "msg_type": "sensor_msgs/Image",
      "corresponding_real_sensor": "Intel RealSense D435 Depth"
    },
    "imu": {
      "blueprint": "sensor.other.imu",
      "ros_topic": "/carla/imu/data",
      "real_topic": "/imu/data",
      "msg_type": "sensor_msgs/Imu"
    },
    "gnss": {
      "blueprint": "sensor.other.gnss",
      "ros_topic": "/carla/gnss/fix",
      "real_topic": "/localization/gnss",
      "msg_type": "sensor_msgs/NavSatFix",
      "enabled": false
    },
    "collision": {
      "blueprint": "sensor.other.collision",
      "ros_topic": "/carla/collision_event",
      "msg_type": "custom_msgs/CollisionEvent"
    },
    "lane_invasion": {
      "blueprint": "sensor.other.lane_invasion",
      "ros_topic": "/carla/lane_invasion_event",
      "msg_type": "custom_msgs/LaneInvasionEvent"
    },
    "obstacle": {
      "blueprint": "sensor.other.obstacle",
      "ros_topic": "/carla/obstacle_event",
      "msg_type": "custom_msgs/ObstacleDetectionEvent"
    }
  }
}
