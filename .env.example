# HunterSim V3.2.2 环境变量模板（极简版）
# 用法：cp .env.example .env（仓库根目录，docker compose 与本地进程共用）。
# 只改「首启可能要改」与「接入平台需补」两节；其余全部走代码默认值，无需在此声明。
# 本文件只放可公开的开发默认值；.env 已被 .gitignore 排除，切勿提交真实密钥。
#
# 设计口径（V3.2.2 起）：
# - 平台接入开关**默认全开**（cloud.enabled / sim_node.enabled 在代码里即为 True），
#   模板不再逐条写 ENABLED=true；升级改动默认值时不必再同步改本文件。
# - **无凭据即静默跳过**：未配 Kafka 凭据/服务令牌/节点标识时，遥测、上传、注册心跳、
#   节点级结果回传一律安全降级为 no-op，绝不阻断本机仿真；`huntersim doctor` 对应项
#   记 warn（而非 fail），不再拦住 `huntersim up`。
# - 绝大多数调优项（看门狗、录制、MJPEG 流、VIL 对齐、上传重试、探针/可视化…）都有合理
#   默认，**不在本模板罗列**；需要覆盖时按 `变量名=值` 追加即可（键名见
#   src/hunter_sim/common/models.py 与 user_manual.md）。
#
# 纯本机联调：整份文件可一行不改、或全部注释，直接 `huntersim up`（默认 127.0.0.1 监听）。
# 暂不接入平台、想让 doctor 干净：把本行取消注释即可（对应检查项转为 skip）。
# HUNTER_CORE_ENABLED=false
# HUNTER_CORE_SIM_NODE_ENABLED=false

# ── 首启可能要改（本机）─────────────────────────────────────────────────────
# CARLA 引擎地址：Windows/Linux 宿主机源码直跑用 127.0.0.1；容器内保持 host.docker.internal
CARLA_HOST=127.0.0.1
# 安装的 CARLA Python SDK 版本，必须与 CARLA server 严格一致
CARLA_VERSION=0.9.16
# 日志级别（DEBUG / INFO / WARNING / ERROR / CRITICAL）；生产采集可加 HUNTER_SIM_LOG_JSON=true
HUNTER_SIM_LOG_LEVEL=INFO

# ── 接入平台需补（本机联调可整块留空/注释）─────────────────────────────────
# 以下凭据由 HunterCore 平台「一键开通」产出（详见 HunterCore docs/HunterSim接入清单.md §1.5）：
#   管理员 `POST /api/v1/scene/sim-nodes` 一步产出 SCRAM 口令 + 双证书 + 接入包；
#   ⚠ 接入包由**管理员下载并转交**（GET /bundle 挂 scene:execute、内含 Kafka 私钥，节点
#   服务令牌 data-uploader 无权下载）。仿真端三步：① 用管理员转交的包执行
#   `huntersim connect --bundle <路径>` 本地解压 ② 把一次性 SCRAM 口令填入 kafka.properties
#   ③ 用包内证书启用下发 TLS/mTLS。
#
# 平台地址：节点注册建议走 web-portal 80/443（直连网关 8080 会学到容器地址、回访打不通）
HUNTER_CORE_GATEWAY_URL=
# 节点永久标识（与 IP 无关，如 sim-node-01；禁用 IP 命名）
HUNTER_CORE_SIM_NODE_ID=
# 服务令牌 service:{client_id}（V2.0 一键开通下降为可选辅助凭据；旧自注册路径必填）
HUNTER_CORE_SIM_NODE_SERVICE_TOKEN=
# node 模式平台需回访本机 :8090：把管理面监听改为 0.0.0.0（并在防火墙放行平台地址）
# ADAPTER_HOST=0.0.0.0
#
# ── Kafka 统一配置（V3.3.0：同时服务于数据回传 + VIL 消费，无需重复配置）──
# 配好以下 HUNTER_CORE_KAFKA/SASL/CLIENT 组后，VIL 消费端（KAFKA_*）自动继承，
# 无需再单独写 KAFKA_BOOTSTRAP_SERVERS / KAFKA_USERNAME / KAFKA_PASSWORD 等。
# 若需消费端连接另一个 broker，可显式设定 KAFKA_BOOTSTRAP_SERVERS 覆盖。
#
# 数据面回传凭据（Kafka SASL_SSL / SCRAM-SHA-512，端口 9093）：留空则实例级
# carla.{sim_id}.sensor_data 与节点级 simulation.{node_id}.result 回传均降级 no-op。
HUNTER_CORE_KAFKA_BOOTSTRAP=
HUNTER_CORE_SASL_USERNAME=
HUNTER_CORE_SASL_PASSWORD=
# CA 证书（平台 Kafka TLS 校验；留空则自动搜索 data/certs/、data/kafka-certs/，
# 再退到系统信任链）
HUNTER_CORE_CA_CERT_PATH=
# mTLS 客户端证书 / 私钥（取自接入包 client-cert.pem / client-key.pem，须成对；
# HunterCore 9093 强制 ssl.client.auth=required，只配账号不配证书握手会失败）
HUNTER_CORE_CLIENT_CERT_PATH=
HUNTER_CORE_CLIENT_KEY_PATH=
# 证书自动发现（默认 true）：未显式配置路径时搜索 data/certs、data/kafka-certs、certs
# HUNTER_CORE_AUTO_DISCOVER_CERTS=true
# 服务端证书校验（默认 true）；内网自签且暂无正确 CA 时可临时置 false，仅用于排障
# HUNTER_CORE_SSL_VERIFY=true
# 额外的证书目录（分号/逗号分隔，便于接入包放在非默认目录）
# HUNTER_SIM_CERT_DIRS=

# ── V2.0 下发通道 mTLS（三步接入 step3，可选；本机联调保持明文）────────────
# 节点 CARLA 管理 API 启用 TLS 并信任平台 CA：服务端证书/私钥成对配置即启用；
# 再配 CA 证书则校验回访客户端证书，client_auth_required=true 时强制双向 TLS。
# 开启后把注册体协议改为 https（HUNTER_CORE_SIM_NODE_PROTOCOL=https），端口留空复用 ADAPTER_PORT。
# ADAPTER_SSL_CERTFILE=
# ADAPTER_SSL_KEYFILE=
# ADAPTER_SSL_CA_CERTFILE=
# ADAPTER_SSL_CLIENT_AUTH_REQUIRED=true
# ADAPTER_SSL_ALLOWED_CLIENT_CN=sim-platform-sim-node-01
# HUNTER_CORE_SIM_NODE_PROTOCOL=https
