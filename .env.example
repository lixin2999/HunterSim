# HunterSim V2.4.0 环境变量示例
# 使用：cp .env.example .env（仓库根目录，docker compose 与本地进程共用）
# 说明：本文件只放可公开的开发默认值；.env 已被 .gitignore 排除，切勿提交真实密钥。

# ── 运行环境 ────────────────────────────────────────────────────────────────
# dev / staging / prod；prod 会启用启动闸门（拒绝默认 JWT 密钥、CORS 通配、默认管理员口令）
HUNTER_SIM_ENV=dev
# DEBUG / INFO / WARNING / ERROR / CRITICAL
HUNTER_SIM_LOG_LEVEL=INFO

# ── CARLA 引擎（宿主机）────────────────────────────────────────────────────
# Windows 宿主机：启动 CarlaUE4.exe（默认 RPC 2000 / 数据流 2001）
# Linux 宿主机：可执行 docker compose --profile carla up 启动 carla-engine
CARLA_HOST=host.docker.internal
CARLA_RPC_PORT=2000
CARLA_STREAM_PORT=2001
CARLA_TIMEOUT_SECONDS=10.0
# 镜像构建时安装的 CARLA Python SDK 版本，必须与 CARLA server 严格一致
CARLA_VERSION=0.9.16
# 无 manylinux wheel 的平台（如 ARM）置为 false；此时服务可启动，但下发场景返回 503
INSTALL_CARLA=true

# ── REST API 安全 ───────────────────────────────────────────────────────────
# 开发默认值仅用于本地联调；HUNTER_SIM_ENV=prod 时必须替换为 >=32 字符的随机串
# 生成示例：python -c "import secrets; print(secrets.token_urlsafe(48))"
API_JWT_SECRET=dev-only-change-me-at-least-32-characters
API_JWT_EXPIRE_MINUTES=1440
# 内置管理员账号（POST /api/v1/sim/auth/token 换取 JWT）；prod 禁止使用 admin/admin
API_ADMIN_USERNAME=admin
API_ADMIN_PASSWORD=admin
# 生产环境请显式列出允许来源，禁止 "*"
API_CORS_ALLOW_ORIGINS=["*"]
API_STREAM_BASE_URL=webrtc://localhost:8080
API_PORT=8080
# ── V2.6.0：限流与登录退避 ──
# 按客户端 IP 的 API 限流（每分钟请求数；健康探针/metrics/WebSocket 豁免）
API_RATE_LIMIT_PER_MINUTE=1000
API_RATE_LIMIT_ENABLED=true
# 同 IP 连续登录失败达到阈值后指数退避（429 + Retry-After）
API_LOGIN_MAX_FAILED_ATTEMPTS=5
API_LOGIN_BACKOFF_BASE_SECONDS=2.0
API_LOGIN_BACKOFF_MAX_SECONDS=60

# ── Kafka（遥测/数据回传，可选）────────────────────────────────────────────
# compose 内部使用 kafka:9092；连外部集群请改成实际地址
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# ── 资源与生命周期 ──────────────────────────────────────────────────────────
# 自定义地图、回放数据的仓库根目录（相对服务工作目录）
RESOURCE_RESOURCES_DIR=resources
# 实例最大存活时间（秒），到期由后台巡检自动回收并释放场景运行器
RESOURCE_INSTANCE_MAX_LIFETIME_SECONDS=7200
RESOURCE_MAX_INSTANCES_PER_USER=5

# ── 执行面（V2.4.0：多引擎端点库存）────────────────────────────────────────
# 逗号分隔的 CARLA 引擎清单，格式 host:rpc[:stream[:tm]]；留空表示单引擎
# （取 CARLA_HOST/CARLA_RPC_PORT/CARLA_STREAM_PORT，同一时刻只运行一个场景）。
# 例：EXECUTION_ENGINE_ENDPOINTS=carla-engine:2000,carla-engine-2:2000
# 每个实例独占一个端点，端点耗尽时创建实例返回 503；释放后端点可复用。
EXECUTION_ENGINE_ENDPOINTS=
# 端点清单最大解析数量（防误配置超量，1-64）
EXECUTION_MAX_ENGINES=8
# 重启后重新装配运行器时，自动加载该实例已持久化的场景定义
EXECUTION_RESTORE_SCENE_ON_ASSEMBLE=true

# ── 状态持久化（V2.4.0：实例与场景绑定落 SQLite）───────────────────────────
# 开启后实例创建/状态流转/销毁与场景下发同步落盘，服务重启可恢复；
# 源码直跑默认关闭，compose/k8s 部署默认开启。
STATE_ENABLED=true
STATE_DB_PATH=data/state/hunter_sim.db
STATE_RECOVER_INSTANCES=true
STATE_RESTORE_SCENES=true
STATE_BUSY_TIMEOUT_SECONDS=5.0

# ── HunterCore 数据回传（默认关闭）──────────────────────────────────────────
HUNTER_CORE_ENABLED=false
# V2.6.0：bag 上传后台队列容量（有界防积压；队满丢最旧并计数 huntersim_cloud_upload_dropped_total）
HUNTER_CORE_UPLOAD_QUEUE_MAX_SIZE=32
