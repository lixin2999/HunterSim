# HunterSim V3.1.0 环境变量示例
# 使用：cp .env.example .env（仓库根目录，docker compose 与本地进程共用）
# 说明：本文件只放可公开的开发默认值；.env 已被 .gitignore 排除，切勿提交真实密钥。
#
# V3.0.0 架构：仿真端只做「执行」，治理（用户/租户/场景库/批量/审计/OTA）全部归云端。
#   huntersim carla-manager  :8090  唯一业务入口（控制面 + VIL + 场景 + 传感器 + 录制）
#   huntersim probes         :8080  只读探针面（/health + /metrics）
#   huntersim up                   一键启动（预检 + 两进程 + 打开可视化客户端）
# V3.1.0 新增只读可视化客户端（挂控制面 /viz，非第二套业务面，不改平台 10 个端点契约）。
# 已移除的配置前缀：API_*（JWT/CORS/限流/登录退避）、STATE_*（8080 面状态库）、
# PLATFORM_*（多租户/API Key/审计/用户表）、GUI_*（旧桌面客户端）；
# 另移除 EXECUTION_ENGINE_ENDPOINTS（受支持形态 = 单世界串行，端点库存留空即单引擎）。

# ── 运行环境 ────────────────────────────────────────────────────────────────
# dev / staging / prod
HUNTER_SIM_ENV=dev
# DEBUG / INFO / WARNING / ERROR / CRITICAL
HUNTER_SIM_LOG_LEVEL=INFO
# 统一日志：true 时模块日志以 JSON 行渲染（生产采集建议）；log_file 非空时启用轮转文件
HUNTER_SIM_LOG_JSON=false
HUNTER_SIM_LOG_FILE=
HUNTER_SIM_LOG_MAX_BYTES=10485760
HUNTER_SIM_LOG_BACKUP_COUNT=5

# ── CARLA 引擎（宿主机）────────────────────────────────────────────────────
# Windows 宿主机：启动 CarlaUE4.exe（默认 RPC 2000 / 数据流 2001）
# Linux 宿主机：可执行 docker compose --profile carla up 启动 carla-engine
CARLA_HOST=host.docker.internal
CARLA_RPC_PORT=2000
CARLA_STREAM_PORT=2001
CARLA_TIMEOUT_SECONDS=10.0
# 镜像构建时安装的 CARLA Python SDK 版本，必须与 CARLA server 严格一致
CARLA_VERSION=0.9.16
# 无 manylinux wheel 的平台（如 ARM）置为 false；此时服务可启动，但下发场景返回 503
INSTALL_CARLA=true
# 本地 CARLA 进程自愈：仅托管回环端点（127.x/localhost），远程与容器内引擎不受影响
# 开启后服务会拉起并监控 CARLA_SUPERVISOR_BINARY_PATH，崩溃自动重启
CARLA_SUPERVISOR_ENABLED=false
CARLA_SUPERVISOR_BINARY_PATH=
# 启动附加参数（空格分隔），如 -quality-level=Low -RenderOffScreen
CARLA_SUPERVISOR_EXTRA_ARGS=
# 5 分钟窗口内允许的自动重启次数与两次重启的退避时长
CARLA_SUPERVISOR_MAX_RESTARTS=3
CARLA_SUPERVISOR_RESTART_BACKOFF_SECONDS=5.0
# 拉起后等待 RPC 端口就绪的超时；关停时等待进程优雅退出的时长
CARLA_SUPERVISOR_READY_TIMEOUT_SECONDS=60.0
CARLA_SUPERVISOR_GRACEFUL_SHUTDOWN_SECONDS=10.0

# ── Kafka（VIL 遥测消费 + sensor_data 回传）──────────────────────────────────
# compose 内部使用 kafka:9092；连外部集群请改成实际地址
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
# VIL 遥测 Topic（含 {sim_id} 模板，运行时渲染）
KAFKA_TELEMETRY_TOPIC=carla.{sim_id}.vil_state
# 当前实例 sim_id（单机调试手动指定；多实例由平台注入）
KAFKA_SIM_ID=
# 兼容旧版遥测 Topic（留空则不订阅旧 telemetry_clean）
KAFKA_LEGACY_TELEMETRY_TOPIC=
# 消费自愈：连续轮询错误达阈值后重建消费者；坏消息（JSON 解析失败）转发 DLQ
KAFKA_ENABLE_SELF_HEAL=true
KAFKA_REBUILD_AFTER_ERRORS=10
KAFKA_DLQ_TOPIC=

# ── VIL 链路对齐（V3.0.0：10Hz 栅格降采样 + 时间对齐插值）────────────────────
# 仿真栅格频率：与 CARLA fixed_delta_seconds=0.02（50Hz）配合，取 10Hz 最稳定
VIL_TARGET_HZ=10.0
# 位姿外推窗口（毫秒）：只有左侧帧时在窗口内线性外推，超窗退化为取最近帧
VIL_EXTRAPOLATION_MS=150
# 超过该延迟即认定断流，实例置 PAUSED(vil_data_interrupted)
VIL_MAX_DATA_LATENCY_MS=500
VIL_WARNING_LATENCY_MS=50
VIL_BUFFER_MAX_FRAMES=10
# 按 timestamp+seq 丢弃乱序/重复遥测；环深按 ceil(外推窗口/1000×频率)+余量自动推导
VIL_ORDERING_GUARD_ENABLED=true
VIL_AUTO_BUFFER_DEPTH=true
VIL_TELEMETRY_FREQUENCY_HZ=10.0
# 车辆状态同步开关：感知框叠加（每 3 个栅格绘制一次）与灯光（刹车/转向/近光）
VIL_OVERLAY_ENABLED=true
VIL_LIGHTS_ENABLED=true
# 时钟偏置自动估计（实车与仿真端时钟不同源时开启；false 表示假设两端已同步，仅记录 skew）
VIL_CLOCK_OFFSET_AUTO=false

# ── 资源与生命周期 ──────────────────────────────────────────────────────────
# 实例最大存活时间（秒）；超时回收由控制面看门狗承担
RESOURCE_INSTANCE_MAX_LIFETIME_SECONDS=7200
RESOURCE_HEALTH_CHECK_INTERVAL_SECONDS=10

# ── 执行面（单世界串行）─────────────────────────────────────────────────────
# 重启后重新装配运行器时，自动加载该实例已持久化的场景定义
EXECUTION_RESTORE_SCENE_ON_ASSEMBLE=true
# 引擎租约心跳：心跳超过 TTL 未续判定为僵尸租约
EXECUTION_LEASE_HEARTBEAT_ENABLED=true
EXECUTION_LEASE_TTL_SECONDS=120

# ── 控制面（V2.13.0：huntersim carla-manager，V3.0.0 起为唯一业务入口）──────────
# 平台 scene-service 通过 CARLA_MANAGEMENT_ENDPOINT 调用；默认仅监听本机，禁止暴露公网
ADAPTER_HOST=127.0.0.1
ADAPTER_PORT=8090
# 实例注册表（重启恢复/幂等）与产物本地暂存目录；容器部署需挂载可写卷
ADAPTER_DB_PATH=data/adapter/carla_instances.db
ADAPTER_ARTIFACTS_DIR=data/adapter/artifacts
ADAPTER_ARTIFACT_BUCKET=hunter-scene-assets
# 传感器录制目录（mcap 落盘）+ 保留期清理（小时，0 表示不清理；doctor 检查剩余空间 ≥5GiB）
ADAPTER_RECORDINGS_DIR=data/adapter/recordings
ADAPTER_RECORDING_RETENTION_HOURS=24
# 录制总开关（false 时忽略场景 sensors[].record，整体不录）
ADAPTER_RECORD_ENABLED=true
# 录制所需最小空闲磁盘（GB）：启动前不足则不录，运行期每 5s 复查、低于阈值主动停录（0 = 不检查）
ADAPTER_RECORD_MIN_FREE_GB=0.5
# 失败/取消/看门狗超时路径是否也上传已录 mcap（默认 false，避免残片污染平台 sensor_file 列表）
ADAPTER_UPLOAD_ON_FAILURE=false
# 产物暂存目录（artifacts/）保留期清理（小时，0 = 不清理）；看门狗周期删除过期 scene 目录
ADAPTER_ARTIFACT_RETENTION_HOURS=72
# MJPEG 推流帧率（与 VIL 栅格一致）、横向降采样上限（像素，0 = 不降采样）与截图 JPEG 质量（1-100）
# 并发客户端上限（超限返回 503 stream_limit_reached；0 = 不限）
ADAPTER_STREAM_FPS=10.0
ADAPTER_STREAM_MAX_WIDTH=640
ADAPTER_STREAM_MAX_CLIENTS=8
ADAPTER_SCREENSHOT_QUALITY=75
# 看门狗：duration × factor + grace（秒）；超时实例置 failed(watchdog_timeout)
ADAPTER_WATCHDOG_FACTOR=3.0
ADAPTER_WATCHDOG_GRACE_SECONDS=120
ADAPTER_PROGRESS_INTERVAL_SECONDS=0.5
# SQLite 忙等待超时（多线程写注册表时避免立即 SQLITE_BUSY）
ADAPTER_BUSY_TIMEOUT_SECONDS=5.0
# 场景未给 duration 时的默认值，以及平台下发时长上限（秒）
ADAPTER_DEFAULT_DURATION_SECONDS=60
ADAPTER_MAX_SCENE_SECONDS=7200

# ── 只读探针面（huntersim probes，:8080 ─────────────────────────────────────
# 仅 /health 与 /metrics，无业务无鉴权；真实状态经 adapter_url 向控制面聚合
PROBE_HOST=127.0.0.1
PROBE_PORT=8080
PROBE_ADAPTER_URL=http://127.0.0.1:8090

# ── 仿真可视化客户端（V3.1.0，挂控制面 /viz）────────────────────────────────
# 只读单页应用：实时画面（MJPEG）/ 传感器（ROS 话题）/ 场景事件 / 仿真日志
# 页面地址 http://<ADAPTER_HOST>:<ADAPTER_PORT>/viz ，huntersim up 会自动打开
VIZ_ENABLED=true
# huntersim up 就绪后是否自动打开浏览器（命令行 --no-browser 可临时关闭）
VIZ_AUTO_OPEN_BROWSER=true
# 日志面板环形缓冲条数（进程内只读旁路，进程重启即清空）
VIZ_LOG_BUFFER_SIZE=2000
# 首屏历史回放条数与事件面板返回条数上限
VIZ_LOG_HISTORY_LIMIT=500
VIZ_EVENT_LIMIT=200
# 激光雷达俯视抽样点数上限 / 深度图输出宽度上限（像素）
VIZ_LIDAR_MAX_POINTS=4000
VIZ_DEPTH_MAX_WIDTH=480

# ── HunterCore 平台接入（默认关闭）───────────────────────────────────────────
HUNTER_CORE_ENABLED=false
# Kafka broker（SASL_SSL；与 KAFKA_BOOTSTRAP_SERVERS 可不同）
HUNTER_CORE_KAFKA_BOOTSTRAP=192.168.31.35:9092
HUNTER_CORE_SECURITY_PROTOCOL=SASL_SSL
HUNTER_CORE_SASL_MECHANISM=SCRAM-SHA-512
HUNTER_CORE_SASL_USERNAME=
HUNTER_CORE_SASL_PASSWORD=
# CA 证书路径（None 则使用系统信任链）
HUNTER_CORE_CA_CERT_PATH=
# mTLS 客户端证书 / 私钥（HunterCore 9093 强制双向 TLS：ssl.client.auth=required）
# 取自接入包 client-cert.pem / client-key.pem，必须成对配置；
# 仅配 SASL 账号、不配客户端证书时 TLS 握手会失败（producer 降级为 no-op）
HUNTER_CORE_CLIENT_CERT_PATH=
HUNTER_CORE_CLIENT_KEY_PATH=
# sensor_data Topic 模板（{sim_id} 运行时由实例 ID 渲染）
HUNTER_CORE_SENSOR_DATA_TOPIC_TEMPLATE=carla.{sim_id}.sensor_data
HUNTER_CORE_SENSOR_DATA_DLQ_TEMPLATE=carla.{sim_id}.sensor_data.dlq
HUNTER_CORE_SENSOR_DATA_ACKS=all
HUNTER_CORE_SENSOR_DATA_MAX_INFLIGHT=5
# sim_status 定时上报周期（秒）
HUNTER_CORE_STATUS_REPORT_INTERVAL_S=1.0
# sim_telemetry 发布周期（100ms = 10Hz）
HUNTER_CORE_TELEMETRY_PROXY_INTERVAL_S=0.1
# sim_id 前缀（单机模式；多实例由平台注入）
HUNTER_CORE_SIM_ID_PREFIX=sim
# 当前实例 sim_id（单机调试手动指定；留空运行时自生成）
HUNTER_CORE_SIM_ID=
# data-collector api-gateway 基础地址
HUNTER_CORE_GATEWAY_URL=http://192.168.31.35:8080
HUNTER_CORE_JWT_TOKEN=
HUNTER_CORE_ROSBAG_BUCKET=hunter-rosbag
HUNTER_CORE_UPLOAD_TIMEOUT_S=60.0
# bag/mcap 上传后台队列容量（有界防积压；队满丢最旧并计数）
HUNTER_CORE_UPLOAD_QUEUE_MAX_SIZE=32
# 上传失败自动重试次数（0 = 不重试）与退避秒数（stop() 时立即中断等待）
HUNTER_CORE_UPLOAD_MAX_RETRIES=2
HUNTER_CORE_UPLOAD_RETRY_BACKOFF_S=1.0
